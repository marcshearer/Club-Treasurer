{
  "default-configuration": "Release",
  "configurations": [
    "Debug",
    "Release",
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
    ],
  },
  "packages": [
    {
      "kind": "local",
      "path": "../ModelGenerator",
    },
  ],
  "files": [
    {
      "kind": "group",
      "path": "ClubTreasurer",
      "children": [
        {
          "kind": "group",
          "path": "Main App",
          "children": [
            {
              "kind": "group",
              "name": "Standard Components",
              "children": [
                { "path": "Assets.xcassets", "target-membership": [ "ClubTreasurer/resources" ] },
                { "path": "MyApp.swift", "target-membership": [ "ClubTreasurer/compile-sources" ] },
                { "path": "Club Treasurer App.swift", "target-membership": [ "ClubTreasurer/compile-sources" ] },
                { "path": "Persistence.swift", "target-membership": [ "ClubTreasurer/compile-sources" ] },
                { "path": "UserDefaults.swift", "target-membership": [ "ClubTreasurer/compile-sources" ] },
                { "path": "Declarations.swift", "target-membership": [ "ClubTreasurer/compile-sources" ] },
                { "path": "Settings.swift", "target-membership": [ "ClubTreasurer/compile-sources" ] },
                { "path": "Controls.swift", "target-membership": [ "ClubTreasurer/compile-sources" ] },
              ],
            }, {
              "kind": "group",
              "name": "Libraries",
              "children": [
                { "path": "Core Data.swift", "target-membership": [ "ClubTreasurer/compile-sources" ] },
                { "path": "Flags.swift", "target-membership": [ "ClubTreasurer/compile-sources" ] },
                { "path": "Custom View Animations.swift", "target-membership": [ "ClubTreasurer/compile-sources" ] },
                { "path": "Other Extensions.swift", "target-membership": [ "ClubTreasurer/compile-sources" ] },
                { "path": "String Extensions.swift", "target-membership": [ "ClubTreasurer/compile-sources" ] },
                { "path": "Date Extensions.swift", "target-membership": [ "ClubTreasurer/compile-sources" ] },
                { "path": "My Color.swift", "target-membership": [ "ClubTreasurer/compile-sources" ] },
                { "path": "Utility.swift", "target-membership": [ "ClubTreasurer/compile-sources" ] },
                { "path": "Utility Extension.swift", "target-membership": [ "ClubTreasurer/compile-sources" ] },
                { "path": "Palette.swift", "target-membership": [ "ClubTreasurer/compile-sources" ] },
                { "path": "Themes.swift", "target-membership": [ "ClubTreasurer/compile-sources" ] },
              ],
            }, {
              "kind": "group",
              "name": "Utilities",
              "children": [
                { "path": "Object Model.swift", "target-membership": [ "ClubTreasurer/compile-sources" ] },
                { "path": "Version.swift", "target-membership": [ "ClubTreasurer/compile-sources" ] },
              ],
            }, {
              "kind": "group",
              "name": "Reusable SwiftUI Components",
              "children": [
                { "path": "Banner.swift", "target-membership": [ "ClubTreasurer/compile-sources" ] },
                { "path": "Double Column View.swift", "target-membership": [ "ClubTreasurer/compile-sources" ] },
                { "path": "Input String.swift", "target-membership": [ "ClubTreasurer/compile-sources" ] },
                { "path": "Input Integer.swift", "target-membership": [ "ClubTreasurer/compile-sources" ] },
                { "path": "Input Float.swift", "target-membership": [ "ClubTreasurer/compile-sources" ] },
                { "path": "Input Title.swift", "target-membership": [ "ClubTreasurer/compile-sources" ] },
                { "path": "Clickable Text.swift", "target-membership": [ "ClubTreasurer/compile-sources" ] },
                { "path": "Inset View.swift", "target-membership": [ "ClubTreasurer/compile-sources" ] },
                { "path": "List Tile View.swift", "target-membership": [ "ClubTreasurer/compile-sources" ] },
                { "path": "Message Box.swift", "target-membership": [ "ClubTreasurer/compile-sources" ] },
                { "path": "Popup Menu.swift", "target-membership": [ "ClubTreasurer/compile-sources" ] },
                { "path": "Separator.swift", "target-membership": [ "ClubTreasurer/compile-sources" ] },
                { "path": "Slide In Menu.swift", "target-membership": [ "ClubTreasurer/compile-sources" ] },
                { "path": "Standard View.swift", "target-membership": [ "ClubTreasurer/compile-sources" ] },
                { "path": "Swipe Gestures.swift", "target-membership": [ "ClubTreasurer/compile-sources" ] },
                { "path": "Target View Modifiers.swift", "target-membership": [ "ClubTreasurer/compile-sources" ] },
                { "path": "Toolbar View.swift", "target-membership": [ "ClubTreasurer/compile-sources" ] },
                { "path": "Undo Handler.swift", "target-membership": [ "ClubTreasurer/compile-sources" ] },
                { "path": "Custom Button.swift", "target-membership": [ "ClubTreasurer/compile-sources" ] },
                { "path": "Overlap Button.swift", "target-membership": [ "ClubTreasurer/compile-sources" ] },
              ],
            }, {
              "kind": "group",
              "name": "Model Definitions",
              "children": [
                { "path": "Bank Account.modeldef", "target-membership": [ "ClubTreasurer/resources" ] },
                { "path": "Statement.modeldef", "target-membership": [ "ClubTreasurer/resources" ] },
                { "path": "Statement Line.modeldef", "target-membership": [ "ClubTreasurer/resources" ] },
